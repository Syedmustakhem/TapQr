//
// QR CODE
//

model QRCode {
  id String @id @default(cuid())

  businessId String

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Cascade
  )

  name String

  description String?

  type QRType @default(DYNAMIC)

  destinationUrl String

  shortCode String @unique

  status QRStatus @default(ACTIVE)

  scanCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  // Scan analytics
  scanEvents ScanEvent[]

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

//
// QR SCAN EVENTS
//

model ScanEvent {
  id String @id @default(cuid())

  qrCodeId String

  qrCode QRCode @relation(
    fields: [qrCodeId],
    references: [id],
    onDelete: Cascade
  )

  ipAddress String?

  country String?
  city String?

  browser String?
  device String?
  operatingSystem String?

  referrer String?
  userAgent String?

  scannedAt DateTime @default(now())

  @@index([qrCodeId])
  @@index([scannedAt])
  @@index([country])
  @@index([city])
}

