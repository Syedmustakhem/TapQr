generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER / AUTHENTICATION
// ============================================================

model User {
  id                      String                  @id @default(uuid())
  fullName                String
  email                   String?                 @unique
  phone                   String?                 @unique
  role                    UserRole                @default(OWNER)
  isActive                Boolean                 @default(true)
  reviews                 Review[]
  reviewReports           ReviewReport[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  authProviders           AuthProvider[]
  businesses              Business[]
  sentInvitations         BusinessInvitation[]
  memberships             BusinessMember[]

  invitedMembers BusinessMember[] @relation("InvitedBy")
}

model AuthProvider {
  id             String           @id @default(uuid())
  provider       AuthProviderType
  passwordHash   String?
  providerUserId String?
  isVerified     Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, userId])
  @@index([userId])
  @@index([provider])
  @@index([providerUserId])
}

model OtpVerification {
  id String @id @default(uuid())

  // Email address OR normalized E.164 phone number
  identifier String
  channel    OtpChannel

  // Never store raw OTP
  otpHash String

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([identifier, channel])
  @@index([expiresAt])
  @@index([consumed])
}

// ============================================================
// BUSINESS
// ============================================================

model Business {
  id            String         @id @default(uuid())
  ownerId       String
  name          String
  slug          String         @unique
  email         String?
  phone         String?
  logo          String?
  description   String?
  status        BusinessStatus @default(ACTIVE)
  reviews       Review[]
  reviewReports ReviewReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  notifications Notification[]
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  profile BusinessProfile?

  members BusinessMember[]

  whatsappAccounts WhatsAppBusinessAccount[]

  invitations BusinessInvitation[]

  qrCodes          QRCode[]
  whatsappContacts WhatsAppContact[]
  conversations    Conversation[]
  whatsappMessages WhatsAppMessage[]
  catalogs         Catalog[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// BUSINESS PROFILE
// Everything a guest can see after scanning a QR.
// ============================================================

model BusinessProfile {
  id         String @id @default(cuid())
  businessId String @unique

  tagline           String?
  description       String?
  externalReviewUrl String?
  website           String?

  email    String?
  phone    String?
  whatsapp String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("India")

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Example:
  // {
  //   "monday": {"open":"09:00","close":"21:00"},
  //   "tuesday": {"open":"09:00","close":"21:00"}
  // }
  openingHours Json?

  // Example:
  // {
  //   "instagram":"https://instagram.com/...",
  //   "facebook":"https://facebook.com/..."
  // }
  socialLinks Json?

  coverImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([state])
}

// ============================================================
// BUSINESS MEMBERS / STAFF
// ============================================================

model BusinessMember {
  id         String @id @default(uuid())
  userId     String
  businessId String

  assignedConversations Conversation[] @relation("ConversationAssignedMember")

  role   BusinessMemberRole   @default(STAFF)
  status BusinessMemberStatus @default(ACTIVE)

  invitedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invitedBy User? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([role])
  @@index([status])
  @@index([invitedById])
}

// ============================================================
// BUSINESS INVITATIONS
// ============================================================

model BusinessInvitation {
  id          String @id @default(uuid())
  businessId  String
  invitedById String

  email  String
  role   BusinessMemberRole
  status InvitationStatus   @default(PENDING)

  token String @unique

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invitedById])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// BUSINESS REVIEWS
// Customer ratings and feedback collected through TapQR.
// ============================================================

model Review {
  id String @id @default(cuid())

  businessId String
  qrCodeId   String?

  // Optional when the reviewer has a TapQR account.
  userId String?

  // Guest reviewer information.
  reviewerName  String?
  reviewerEmail String?

  rating Int

  title   String?
  comment String?

  status ReviewStatus @default(PENDING)

  // True when the review was associated with a
  // valid TapQR interaction/verification flow.
  isVerified Boolean @default(false)

  verifiedAt DateTime?

  // Optional business response.
  ownerResponse String?
  respondedAt   DateTime?

  // Moderation/reporting.
  reportedAt     DateTime?
  moderatedAt    DateTime?
  moderationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  qrCode QRCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  reports ReviewReport[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, rating])
  @@index([businessId, createdAt])
  @@index([qrCodeId])
  @@index([userId])
  @@index([status])
  @@index([isVerified])
}

// ============================================================
// REVIEW REPORTS
// Allows customers/businesses to flag abusive content.
// ============================================================

model ReviewReport {
  id String @id @default(cuid())

  reviewId   String
  userId     String?
  businessId String

  reason  String
  details String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// QR CODE
// ============================================================

model QRCode {
  id         String  @id @default(cuid())
  businessId String
  catalogId  String?

  name        String
  description String?
  reviews     Review[]
  type        QRType   @default(DYNAMIC)

  // Used only for REDIRECT experience.
  destinationUrl String?

  // Public QR identifier.
  shortCode String @unique

  status QRStatus @default(ACTIVE)

  // Determines what the guest sees.
  //
  // BUSINESS  -> complete business page
  // CATALOG   -> catalog experience
  // MENU      -> restaurant/menu experience
  // SERVICES  -> service experience
  // PRODUCTS  -> product experience
  // CONTACT   -> contact experience
  // REDIRECT  -> direct URL redirect
  experienceType QRExperienceType @default(BUSINESS)

  // Controls which sections appear
  // on the guest page.
  //
  // Example:
  // [
  //   "PROFILE",
  //   "CATALOG",
  //   "OFFERS",
  //   "CONTACT",
  //   "LOCATION"
  // ]
  enabledSections Json?

  scanCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  catalog Catalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  branding QRBranding?
  rules    QRRule[]

  experiments QRExperiment[]

  ruleMatches QRRuleMatch[]

  conversions QRConversion[]

  overrides      QRRuleOverride[]
  scanEvents     ScanEvent[]
  conversations  Conversation[]
  sourceType     QRSourceType     @default(OTHER)
  placementLabel String?
  locationLabel  String?
  campaignName   String?
  lastScannedAt  DateTime?

  @@index([businessId, sourceType])
  @@index([lastScannedAt])
  @@index([businessId])
  @@index([catalogId])
  @@index([status])
  @@index([experienceType])
  @@index([createdAt])
  @@index([businessId, status])
}

// ============================================================
// QR BRANDING
// ============================================================

model QRBranding {
  id       String @id @default(cuid())
  qrCodeId String @unique

  primaryColor      String?
  secondaryColor    String?
  backgroundColor   String?
  qrForegroundColor String?
  qrBackgroundColor String?

  logoUrl       String?
  coverImageUrl String?

  buttonStyle String?
  fontFamily  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
}

// ============================================================
// CATALOG
//
// One business can have multiple catalogs.
//
// Restaurant:
//   Menu -> Categories -> Menu Items
//
// Supermarket:
//   Products -> Categories -> Products
//
// Salon:
//   Services -> Categories -> Services
//
// General:
//   Catalog -> Categories -> Items
// ============================================================

model Catalog {
  id         String @id @default(cuid())
  businessId String

  name        String
  description String?

  type CatalogType @default(GENERAL)

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categories CatalogCategory[]

  qrCodes QRCode[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, sortOrder])
}

// ============================================================
// CATALOG CATEGORY
// ============================================================

model CatalogCategory {
  id        String @id @default(cuid())
  catalogId String

  name        String
  description String?
  image       String?

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  items CatalogItem[]

  @@index([catalogId])
  @@index([catalogId, isActive])
  @@index([catalogId, sortOrder])
}

// ============================================================
// CATALOG ITEM
//
// Universal item model.
//
// PRODUCT     -> supermarket / retail
// MENU_ITEM   -> restaurant
// SERVICE     -> salon / agency / professional
// PACKAGE     -> bundled service/product
// OFFER       -> promotional item
// ============================================================

model CatalogItem {
  id         String @id @default(cuid())
  categoryId String

  name        String
  description String?

  type CatalogItemType @default(PRODUCT)

  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  currency String @default("INR")

  image   String?
  gallery Json?

  sku  String?
  unit String?

  stock Decimal? @db.Decimal(12, 3)

  // Useful for services.
  durationMinutes Int?

  isAvailable Boolean @default(true)
  isFeatured  Boolean @default(false)

  sortOrder Int @default(0)

  // Flexible data for industry-specific fields.
  //
  // Example restaurant:
  // {
  //   "isVeg": true,
  //   "spicy": "medium",
  //   "calories": 450
  // }
  //
  // Example supermarket:
  // {
  //   "brand": "Amul",
  //   "weight": "500g"
  // }
  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  variants     CatalogItemVariant[]
  optionGroups CatalogItemOptionGroup[]

  @@index([categoryId])
  @@index([categoryId, isAvailable])
  @@index([type])
  @@index([sku])
  @@index([createdAt])
}

// ============================================================
// ITEM VARIANTS
//
// Examples:
//
// Pizza:
//   Small  -> Ã¢â€šÂ¹149
//   Medium -> Ã¢â€šÂ¹249
//   Large  -> Ã¢â€šÂ¹349
//
// Milk:
//   500ml -> Ã¢â€šÂ¹30
//   1L    -> Ã¢â€šÂ¹55
// ============================================================

model CatalogItemVariant {
  id     String @id @default(cuid())
  itemId String

  name String

  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  sku String?

  stock Decimal? @db.Decimal(12, 3)

  isAvailable Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, isAvailable])
  @@index([sku])
}

// ============================================================
// ITEM OPTION GROUP
//
// Example:
//
// Pizza
//   Crust
//     Thin      +Ã¢â€šÂ¹0
//     Cheese    +Ã¢â€šÂ¹50
//
//   Toppings
//     Paneer    +Ã¢â€šÂ¹40
//     Mushroom  +Ã¢â€šÂ¹30
// ============================================================

model CatalogItemOptionGroup {
  id     String @id @default(cuid())
  itemId String

  name String

  required Boolean @default(false)

  minSelect Int @default(0)
  maxSelect Int @default(1)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  options CatalogItemOption[]

  @@index([itemId])
}

// ============================================================
// ITEM OPTIONS
// ============================================================

model CatalogItemOption {
  id      String @id @default(cuid())
  groupId String

  name String

  price Decimal @default(0) @db.Decimal(12, 2)

  isAvailable Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group CatalogItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// ============================================================
// QR SCAN ANALYTICS
// ============================================================

model ScanEvent {
  id       String @id @default(cuid())
  qrCodeId String

  ipAddress String?

  country String?
  city    String?

  browser         String?
  device          String?
  operatingSystem String?

  referrer  String?
  userAgent String?

  scannedAt          DateTime      @default(now())
  sourceTypeSnapshot QRSourceType?
  qrCode             QRCode        @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([sourceTypeSnapshot])
  @@index([qrCodeId])
  @@index([scannedAt])
  @@index([country])
  @@index([city])
  @@index([qrCodeId, scannedAt])
}

// ============================================================
// WHATSAPP BUSINESS SUPPORT
// ============================================================

model WhatsAppContact {
  id String @id @default(cuid())

  businessId String

  phoneNumber String
  profileName String?
  displayName String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  conversations Conversation[]

  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([phoneNumber])
  @@index([lastSeenAt])
}

// ============================================================
// WHATSAPP CONVERSATION
// ============================================================

model Conversation {
  id String @id @default(cuid())

  businessId String
  contactId  String

  // QR that started/created the conversation
  qrCodeId String?

  status ConversationStatus @default(OPEN)

  priority ConversationPriority @default(NORMAL)

  assignedToId String?

  assignedTo    BusinessMember? @relation("ConversationAssignedMember", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contact WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  qrCode QRCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  messages WhatsAppMessage[]

  @@index([businessId])
  @@index([contactId])
  @@index([qrCodeId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([lastMessageAt])
}

model WhatsAppBusinessAccount {
  id String @id @default(cuid())

  businessId String

  phoneNumberId     String
  businessAccountId String?

  displayPhoneNumber String?
  verifiedName       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([phoneNumberId])
  @@index([businessId])
  @@index([businessAccountId])
}

// ============================================================
// WHATSAPP MESSAGE
// ============================================================

model WhatsAppMessage {
  id String @id @default(cuid())

  businessId     String
  conversationId String

  // Meta WhatsApp message ID
  whatsappMessageId String? @unique

  direction WhatsAppMessageDirection

  type WhatsAppMessageType @default(TEXT)

  text String?

  // Meta media ID / URL if applicable
  mediaId  String?
  mediaUrl String?

  status WhatsAppMessageStatus @default(PENDING)

  errorCode    String?
  errorMessage String?

  // Useful for templates
  templateName String?

  // Raw Meta payload when needed for debugging
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([conversationId])
  @@index([status])
  @@index([direction])
  @@index([createdAt])
  @@index([whatsappMessageId])
}

model Notification {
  id String @id @default(uuid())

  userId     String
  businessId String?

  type NotificationType

  title   String
  message String

  actionUrl String?
  metadata  Json?

  eventKey String

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  // NULL = unread
  // timestamp = read
  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  business   Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@unique([userId, eventKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([businessId, createdAt])
  @@index([type, createdAt])
}

model NotificationDelivery {
  id String @id @default(uuid())

  notificationId String
  channel        NotificationChannel

  status NotificationStatus @default(PENDING)

  providerMessageId String?
  providerResponse  Json?

  attempts Int @default(0)

  lastAttemptAt DateTime?
  sentAt        DateTime?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@index([channel, status])
}

model NotificationPreference {
  id String @id @default(uuid())

  userId String @unique

  emailEnabled    Boolean @default(true)
  whatsappEnabled Boolean @default(true)

  securityEnabled  Boolean @default(true)
  authEnabled      Boolean @default(true)
  businessEnabled  Boolean @default(true)
  qrEnabled        Boolean @default(true)
  staffEnabled     Boolean @default(true)
  reviewEnabled    Boolean @default(true)
  analyticsEnabled Boolean @default(true)
  billingEnabled   Boolean @default(true)
  systemEnabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// SMART QR RULE
// ============================================

// ============================================
// ADVANCED SMART QR RULE
// ============================================

model QRRule {
  id String @id @default(cuid())

  qrCodeId String

  name        String
  description String?

  status QRRuleStatus @default(DRAFT)

  /**
   * Higher priority executes first.
   */
  priority Int @default(0)

  /**
   * Optional activation window.
   */
  startsAt DateTime?
  endsAt   DateTime?

  /**
   * Top-level condition logic.
   */
  logic QRRuleLogic @default(AND)

  /**
   * Action executed when the rule matches.
   */
  actionType  QRRuleActionType
  actionValue String

  /**
   * Optional fallback specific to this rule.
   */
  fallbackActionType  QRRuleActionType?
  fallbackActionValue String?

  /**
   * Runtime statistics.
   */
  matchCount Int @default(0)

  lastMatchedAt DateTime?

  /**
   * Version currently published.
   */
  publishedVersion Int?

  /**
   * Optional experiment.
   */
  experimentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  conditions QRRuleCondition[]
  versions   QRRuleVersion[]

  experiment QRExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  auditLogs QRRuleAuditLog[]

  overrides             QRRuleOverride[]
  qrruleConditionGroups QRRuleConditionGroup[]
  qrruleMatches         QRRuleMatch[]
  qrconversions         QRConversion[]

  @@index([qrCodeId])
  @@index([qrCodeId, status])
  @@index([qrCodeId, priority])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([experimentId])
}

// ============================================
// SMART QR RULE CONDITION
// ============================================

// ============================================
// ADVANCED SMART QR CONDITION
// ============================================

model QRRuleCondition {
  id String @id @default(cuid())

  ruleId String

  /**
   * Parent condition group.
   * NULL means this belongs directly
   * to the rule.
   */
  groupId String?

  type     QRRuleConditionType
  operator QRRuleOperator

  /**
   * Flexible condition payload.
   */
  value Json

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule QRRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  group QRRuleConditionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([ruleId, sortOrder])
  @@index([groupId])
  @@index([type])
}

// ============================================
// CONDITION GROUP
// ============================================

model QRRuleConditionGroup {
  id String @id @default(cuid())

  ruleId String

  parentGroupId String?

  logic QRRuleLogic @default(AND)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule QRRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  parentGroup QRRuleConditionGroup? @relation("QRRuleConditionGroupTree", fields: [parentGroupId], references: [id], onDelete: Cascade)

  children QRRuleConditionGroup[] @relation("QRRuleConditionGroupTree")

  conditions QRRuleCondition[]

  @@index([ruleId])
  @@index([parentGroupId])
  @@index([ruleId, sortOrder])
}

// ============================================
// SMART QR RULE VERSION
// ============================================
// ============================================
// RULE VERSION
// ============================================

model QRRuleVersion {
  id String @id @default(cuid())

  ruleId String

  version Int

  status QRRuleVersionStatus @default(DRAFT)

  /**
   * Complete immutable snapshot.
   */
  snapshot Json

  createdBy           String?
  publishedBy         String?
  rollbackFromVersion Int?

  publishedAt DateTime?

  createdAt DateTime @default(now())

  rule QRRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([ruleId])
  @@index([ruleId, status])
  @@index([createdAt])
}

// ============================================
// QR EXPERIMENT
// ============================================

model QRExperiment {
  id String @id @default(cuid())

  qrCodeId String

  name        String
  description String?

  status QRExperimentStatus @default(DRAFT)

  allocationType QRExperimentAllocationType @default(PERCENTAGE)

  startsAt DateTime?
  endsAt   DateTime?

  /**
   * Total visitors entering experiment.
   */
  participantCount Int @default(0)

  /**
   * Total conversions attributed
   * to experiment.
   */
  conversionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  rules QRRule[]

  variants                QRExperimentVariant[]
  qrexperimentAssignments QRExperimentAssignment[]

  @@index([qrCodeId])
  @@index([qrCodeId, status])
  @@index([startsAt])
  @@index([endsAt])
}

// ============================================
// EXPERIMENT VARIANT
// ============================================

model QRExperimentVariant {
  id String @id @default(cuid())

  experimentId String

  name String

  /**
   * Example:
   * A = 50
   * B = 50
   */
  allocation Int

  /**
   * Experience/action to execute.
   */
  actionType  QRRuleActionType
  actionValue String

  participantCount Int @default(0)
  conversionCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiment QRExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  assignments QRExperimentAssignment[]

  @@index([experimentId])
}

// ============================================
// EXPERIMENT ASSIGNMENT
// ============================================

model QRExperimentAssignment {
  id String @id @default(cuid())

  experimentId String
  variantId    String

  /**
   * Anonymous visitor identifier.
   * This should be a privacy-conscious
   * application-generated identifier,
   * not raw personal information.
   */
  visitorKey String

  firstAssignedAt DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  experiment QRExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  variant QRExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, visitorKey])
  @@index([experimentId])
  @@index([variantId])
  @@index([visitorKey])
}

// ============================================
// RULE MATCH ANALYTICS
// ============================================

model QRRuleMatch {
  id String @id @default(cuid())

  qrCodeId String

  ruleId String?

  ruleVersion Int?

  status QRRuleMatchStatus

  /**
   * Selected action.
   */
  actionType  QRRuleActionType?
  actionValue String?

  /**
   * Optional experiment information.
   */
  experimentId String?
  variantId    String?

  /**
   * Request context snapshots.
   */
  device          String?
  operatingSystem String?
  browser         String?

  country String?
  state   String?
  city    String?

  language String?

  referrer String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  sourceType String?

  /**
   * Anonymous visitor key.
   */
  visitorKey String?

  matchedAt DateTime @default(now())

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  rule QRRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([qrCodeId, matchedAt])
  @@index([ruleId])
  @@index([experimentId])
  @@index([variantId])
  @@index([status])
  @@index([sourceType])
}

// ============================================
// QR CONVERSION
// ============================================

model QRConversion {
  id String @id @default(cuid())

  qrCodeId String

  ruleId      String?
  ruleVersion Int?

  experimentId String?
  variantId    String?

  /**
   * External/business-defined conversion.
   * Examples:
   * ORDER
   * LEAD
   * BOOKING
   * SIGNUP
   * CALL
   * WHATSAPP
   */
  conversionType String

  externalId String?

  value    Decimal? @db.Decimal(12, 2)
  currency String?

  visitorKey String?

  convertedAt DateTime @default(now())

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  rule QRRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([ruleId])
  @@index([experimentId])
  @@index([variantId])
  @@index([conversionType])
  @@index([convertedAt])
  @@index([externalId])
}

// ============================================
// QR RULE OVERRIDE
// ============================================

model QRRuleOverride {
  id String @id @default(cuid())

  qrCodeId String

  ruleId String?

  type QRRuleOverrideType

  status QRRuleOverrideStatus @default(ACTIVE)

  priority Int @default(10000)

  reason String

  actionType  QRRuleActionType
  actionValue String

  startsAt DateTime?
  endsAt   DateTime?

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  rule QRRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([qrCodeId, status])
  @@index([qrCodeId, priority])
  @@index([startsAt])
  @@index([endsAt])
}

// ============================================
// QR RULE AUDIT LOG
// ============================================

model QRRuleAuditLog {
  id String @id @default(cuid())

  ruleId String

  action QRRuleAuditAction

  actorId String?

  /**
   * Before/after snapshots.
   */
  previousState Json?
  newState      Json?

  metadata Json?

  createdAt DateTime @default(now())

  rule QRRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

