generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum QRType {
  STATIC
  DYNAMIC
}

enum QRStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum AuthProviderType {
  EMAIL
  PHONE
  GOOGLE
}

enum UserRole {
  OWNER
  STAFF
  ADMIN
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

//
// USER
//

model User {
  id String @id @default(uuid())

  fullName String

  email String? @unique
  phone String? @unique

  role     UserRole @default(OWNER)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  authProviders AuthProvider[]

  // Businesses owned by this user
  businesses Business[]

  // Businesses where this user is a member
  memberships BusinessMember[]

  // Invitations sent by this user
  sentInvitations BusinessInvitation[]
}

//
// AUTH PROVIDER
//

model AuthProvider {
  id String @id @default(uuid())

  provider AuthProviderType

  passwordHash String?

  providerUserId String?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([provider, userId])
  @@index([userId])
  @@index([provider])
}

//
// BUSINESS
//

model Business {
  id String @id @default(uuid())

  ownerId String

  owner User @relation(
    fields: [ownerId],
    references: [id],
    onDelete: Cascade
  )

  name String

  slug String @unique

  email String?
  phone String?

  logo String?
  description String?

  status BusinessStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  // Relations
  members BusinessMember[]

  invitations BusinessInvitation[]

  qrCodes QRCode[]

  @@index([ownerId])
  @@index([status])
}

//
// BUSINESS MEMBERS
//

model BusinessMember {
  id String @id @default(uuid())

  userId String
  businessId String

  role BusinessMemberRole @default(STAFF)

  status BusinessMemberStatus @default(ACTIVE)

  invitedById String?

  joinedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([invitedById])
}

//
// QR CODE
//

model QRCode {
  id String @id @default(cuid())

  businessId String

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Cascade
  )

  name String

  description String?

  type QRType @default(DYNAMIC)

  destinationUrl String

  shortCode String @unique

  status QRStatus @default(ACTIVE)

  scanCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  // Scan analytics
  scanEvents ScanEvent[]

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

//
// QR SCAN EVENTS
//

model ScanEvent {
  id String @id @default(cuid())

  qrCodeId String

  qrCode QRCode @relation(
    fields: [qrCodeId],
    references: [id],
    onDelete: Cascade
  )

  ipAddress String?

  country String?
  city String?

  browser String?
  device String?
  operatingSystem String?

  referrer String?
  userAgent String?

  scannedAt DateTime @default(now())

  @@index([qrCodeId])
  @@index([scannedAt])
  @@index([country])
  @@index([city])
}

//
// BUSINESS INVITATIONS
//

model BusinessInvitation {
  id String @id @default(uuid())

  businessId String
  invitedById String

  email String

  role BusinessMemberRole

  status InvitationStatus @default(PENDING)

  token String @unique

  expiresAt DateTime

  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Cascade
  )

  invitedBy User @relation(
    fields: [invitedById],
    references: [id],
    onDelete: Cascade
  )

  @@index([businessId])
  @@index([invitedById])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}