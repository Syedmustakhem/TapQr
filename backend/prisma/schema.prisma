generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(uuid())
  fullName        String
  email           String?              @unique
  phone           String?              @unique
  role            UserRole             @default(OWNER)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  authProviders   AuthProvider[]
  businesses      Business[]
  sentInvitations BusinessInvitation[]
  memberships     BusinessMember[]
}

model AuthProvider {
  id             String           @id @default(uuid())
  provider       AuthProviderType
  passwordHash   String?
  providerUserId String?
  isVerified     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, userId])
  @@index([userId])
  @@index([provider])
}

// NEW: short-lived OTP records for email + WhatsApp verification.
// Never store the raw OTP — only otpHash.
model OtpVerification {
  id String @id @default(uuid())

  identifier String // email address OR E.164 phone number
  channel    OtpChannel

  otpHash String

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([identifier, channel])
  @@index([expiresAt])
}

model Business {
  id          String               @id @default(uuid())
  ownerId     String
  name        String
  slug        String               @unique
  email       String?
  phone       String?
  logo        String?
  description String?
  status      BusinessStatus       @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  invitations BusinessInvitation[]
  members     BusinessMember[]
  qrCodes     QRCode[]

  @@index([ownerId])
  @@index([status])
}

model BusinessMember {
  id          String               @id @default(uuid())
  userId      String
  businessId  String
  role        BusinessMemberRole   @default(STAFF)
  status      BusinessMemberStatus @default(ACTIVE)
  invitedById String?
  joinedAt    DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([invitedById])
}

model QRCode {
  id             String      @id @default(cuid())
  businessId     String
  name           String
  description    String?
  type           QRType      @default(DYNAMIC)
  destinationUrl String
  shortCode      String      @unique
  status         QRStatus    @default(ACTIVE)
  scanCount      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scanEvents     ScanEvent[]

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model ScanEvent {
  id              String   @id @default(cuid())
  qrCodeId        String
  ipAddress       String?
  country         String?
  city            String?
  browser         String?
  device          String?
  operatingSystem String?
  referrer        String?
  userAgent       String?
  scannedAt       DateTime @default(now())
  qrCode          QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
  @@index([country])
  @@index([city])
}

model BusinessInvitation {
  id          String             @id @default(uuid())
  businessId  String
  invitedById String
  email       String
  role        BusinessMemberRole
  status      InvitationStatus   @default(PENDING)
  token       String             @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy   User               @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invitedById])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

enum QRType {
  STATIC
  DYNAMIC
}

enum QRStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum AuthProviderType {
  EMAIL
  PHONE
  GOOGLE
}

// NEW
enum OtpChannel {
  EMAIL
  WHATSAPP
}

enum UserRole {
  OWNER
  STAFF
  ADMIN
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}