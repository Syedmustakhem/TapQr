{
  "family": "tapqr-backend-migration",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::018088156597:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "tapqr-backend-migration",
      "image": "018088156597.dkr.ecr.ap-south-1.amazonaws.com/tapqr-backend-migration:production-init",
      "essential": true,
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:018088156597:secret:tapqr/prod/database-dwSEO2:DATABASE_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tapqr-backend-migration",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "migration"
        }
      }
    }
  ]
}
